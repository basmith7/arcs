{
  "name": "open-arcs",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "comment": "build:site sets VITE_MULTIPLAYER_URL to the empty string on purpose — empty means same origin, unset means multiplayer off. See apps/web/src/multiplayer/config.ts.",
  "scripts": {
    "test": "NODE_OPTIONS=--no-warnings=ExperimentalWarning vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force && tsc -p apps/web --noEmit && tsc -p packages/server-node --noEmit",
    "typecheck:node": "tsc -p packages/server-node --noEmit",
    "dev:server": "npm run dev --workspace @arcs/server-node",
    "build:server": "npm run build --workspace @arcs/server-node",
    "build:all": "npm run build:site && npm run build:server",
    "saves:build": "vite-node scripts/build-test-saves.ts",
    "arena": "vite-node scripts/arena.ts",
    "audit": "vite-node scripts/ambition-audit.ts",
    "do:dump": "vite-node scripts/do-dump.ts",
    "ws:check": "vite-node scripts/ws-check.ts",
    "fit": "vite-node scripts/fit-weights.ts",
    "build:site": "VITE_MULTIPLAYER_URL= npm run build --workspace @arcs/web",
    "serve": "npm run build:site && npm run dev --workspace @arcs/server",
    "deploy": "npm run build:site && npm run deploy --workspace @arcs/server",
    "golden": "vite-node scripts/golden-journals.ts",
    "profile": "vite-node scripts/profile-game.ts",
    "advise": "vite-node scripts/advise.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
